# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment variables ─────────────────────────────────────────────────────
.env
!.env.example

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db.*
*.bak*
*.audit_backup*

# ── Uploads (user files — never commit) ──────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
backend/logs/*
!backend/logs/.gitkeep
*.log

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
.pnp.*
.yarn/

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── Docker ────────────────────────────────────────────────────────────────────
*.env.docker

# ── ML Model Artifacts ───────────────────────────────────────────────────────
backend/app/ml/model_artifacts/*.joblib

# ── NHANES Datasets (large binary files) ─────────────────────────────────────
*.xpt
